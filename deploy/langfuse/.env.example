# Copy to deploy/langfuse/.env (chmod 600, never commit). Generate secrets with:
#   openssl rand -hex 32        (ENCRYPTION_KEY must be exactly 64 hex chars)
#   openssl rand -base64 32     (others)

NEXTAUTH_URL=https://langfuse.example.com
NEXTAUTH_SECRET=CHANGE_ME
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_64_HEX

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME
REDIS_AUTH=CHANGE_ME

# Pin after first install (docker image ls); bump deliberately.
LANGFUSE_VERSION=3

AUTH_DISABLE_SIGNUP=true
TELEMETRY_ENABLED=false

# Headless init: project + API keys the app uses (LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY).
LANGFUSE_INIT_ORG_ID=personal-agent
LANGFUSE_INIT_PROJECT_ID=personal-agent-test
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME
