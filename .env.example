# ===== Multi-provider LLM (OpenAI-compatible) =====
# FAST = low latency (chat / classifiers / summaries)
# STRONG = quality (long drafts / hard reasoning)
#
# Minimal setup: fill KIMI_API_KEY below and keep both tiers on Kimi (default here,
# same as render.yaml). A tier whose model has no matching key runs in mock mode,
# so do not point FAST at DeepSeek unless DEEPSEEK_API_KEY is set as well.
# STRONG kimi-k3 empty responses auto-retry with LLM_STRONG_FALLBACK_MODEL (default kimi-k2.6).
# Never commit a filled .env.

LLM_FAST_BASE_URL=https://api.moonshot.cn/v1
LLM_FAST_API_KEY=
LLM_FAST_MODEL=kimi-k2.6

LLM_STRONG_BASE_URL=https://api.moonshot.cn/v1
LLM_STRONG_API_KEY=
LLM_STRONG_MODEL=kimi-k3
LLM_STRONG_FALLBACK_MODEL=kimi-k2.6

# Extra request-body fields per tier (JSON object). Reasoning models spend small
# max_tokens budgets (tool selection, classifiers) on hidden thinking and return
# empty content; turn thinking off on FAST when the vendor supports it, e.g.
# LLM_FAST_PARAMS={"enable_thinking": false}
# LLM_STRONG_PARAMS={}

# Flat aliases (optional; overridden by LLM_* above when set)
MODEL_FAST=kimi-k2.6
MODEL_STRONG=kimi-k3

# --- Example: FAST on DeepSeek (needs DEEPSEEK_API_KEY) ---
# LLM_FAST_BASE_URL=https://api.deepseek.com/v1
# LLM_FAST_MODEL=deepseek-chat
# MODEL_FAST=deepseek-chat
# DEEPSEEK_API_KEY=

# Provider keys (used when LLM_*_API_KEY empty)
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# Single-provider fallback (if you only use one vendor)
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# Qwen / DashScope example:
# LLM_FAST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_FAST_MODEL=qwen-turbo
# LLM_STRONG_MODEL=qwen-plus
# DASHSCOPE_API_KEY=

# Kimi K3 thinking effort: low=faster
KIMI_K3_EFFORT=low

HOST=0.0.0.0
PORT=8787
DATA_DIR=./data
# Browser CORS: * or comma-separated origins
CORS_ALLOW_ORIGINS=*


# ===== Channel auto-bind (Feishu open_id → user_id) =====
# Applied on startup and via POST /api/channels/auto-bind
FEISHU_BIND_USER_ID=
# Comma-separated: open_id or open_id:display_name
FEISHU_BIND_OPEN_IDS=
# Optional general form (pipe-separated): channel:external:user_id:name
# CHANNEL_AUTO_BIND=feishu:ou_xxx:uuid:显示名|openclaw_wechat:wxid:uuid

# ===== Channels (Feishu / WeChat) — see docs/channels.md =====
# Public HTTPS origin of this service; bind / sandbox links sent into chats use it.
PUBLIC_BASE_URL=
# Required for admin channel APIs (/api/channels/bind, /bindings, /auto-bind).
# Unset = those APIs return 403. Send as X-Admin-Token or Authorization: Bearer.
CHANNEL_ADMIN_TOKEN=
# Lifetime of one-time links (seconds)
CHANNEL_BIND_TTL_SECONDS=900
CHANNEL_SANDBOX_TTL_SECONDS=1800
# The bind page links the channel account to the browser session that opens it.

# ===== Feishu bot (tenant app — fill from open.feishu.cn) =====
# Off by default. FEISHU_ENABLED=1 + APP_ID/SECRET starts the long connection.
FEISHU_ENABLED=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Only for the HTTP fallback /webhooks/feishu (long connection does not need them)
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_API_BASE=https://open.feishu.cn
# Legacy switch; FEISHU_WS_ENABLED=1 is treated like FEISHU_ENABLED=1
FEISHU_WS_ENABLED=
FEISHU_WS_LOG_LEVEL=INFO
FEISHU_WS_MODE=subprocess
FEISHU_WS_CONNECT_RETRIES=5

# ===== WeChat via OpenClaw Gateway (integrations/openclaw-personal-agent-bridge) =====
# Off by default. Inbound: bridge plugin → POST /webhooks/openclaw/wechat (Bearer OPENCLAW_WEBHOOK_TOKEN)
# Outbound push: → OPENCLAW_GATEWAY_URL/tools/invoke (message.send, Bearer OPENCLAW_GATEWAY_TOKEN)
OPENCLAW_WECHAT_ENABLED=0
OPENCLAW_WEBHOOK_TOKEN=
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_WECHAT_CHANNEL=openclaw-weixin
# Seconds to answer inline before acking and pushing the reply later
OPENCLAW_SYNC_WAIT_SECONDS=12
# Deprecated (old /hooks/agent path, no longer used): OPENCLAW_HOOK_TOKEN, OPENCLAW_AGENT_ID

# Gateway timeouts / empty-content escalate (Phase 1)
# LLM_FAST_TIMEOUT=25
# LLM_STRONG_TIMEOUT=60
# LLM_EMPTY_ESCALATE=1
# LLM_STRONG_FALLBACK_MODEL=kimi-k2.6

# ===== Auth for identity-sensitive endpoints (REQUIRED) =====
# Every /api call derives the user ONLY from the signed session cookie / token
# (Authorization: Bearer / X-User-Token). Unset → every /api endpoint returns 503
# and the chat page shows「暂时无法确认你的身份」.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Mint a token by hand: python -m app.auth <user_id> [ttl_seconds]
AUTH_SECRET=

# ===== Agent Loop budgets (per task, tiered by difficulty; 0 disables a dimension) =====
# Task = one inbound request + its confirm-card resumes. Tier comes from the same
# classifier that picks FAST/STRONG: simple = chat / profile / confirm;
# medium = drafts; hard = long-form reasoning.
# One automatic escalation to the next tier per task (logged to traces).
# Near limit (80% or 2 steps left) → wrap up with partial result; at limit →
# "continue" card (+50% of the tier per click, bounded by the per-user cost caps).
# Wall clock restarts on every resume / continue (human wait time is free).
# AGENT_BUDGET_SIMPLE_STEPS=15
# AGENT_BUDGET_SIMPLE_SECONDS=180
# AGENT_BUDGET_SIMPLE_TOKENS=100000
# AGENT_BUDGET_MEDIUM_STEPS=50
# AGENT_BUDGET_MEDIUM_SECONDS=900
# AGENT_BUDGET_MEDIUM_TOKENS=400000
# AGENT_BUDGET_HARD_STEPS=120
# AGENT_BUDGET_HARD_SECONDS=2700
# AGENT_BUDGET_HARD_TOKENS=1500000
# AGENT_BUDGET_<TIER>_COST=0      # optional per-task ¥ cap per tier
# AGENT_TIER_ESCALATION=1         # 0 disables the automatic escalation
# Legacy single budget: AGENT_MAX_STEPS / _SECONDS / _TOKENS still work as a
# fallback for the MEDIUM tier only; AGENT_MAX_COST for any tier without _COST.
# Validation-failure retries per tool loop (attempts = 1 + this)
AGENT_MAX_RETRIES=2
# Auto redrafts after the user rejects a confirm card (reason is fed back)
AGENT_MAX_REDRAFTS=1
# ¥ per 1k estimated tokens (CJK≈1 token/char, other≈1/4 chars)
# AGENT_COST_PER_1K_TOKENS=0.012

# ===== Per-user cost caps (¥, 0 disables) =====
# On cap: task stops, tells the user when it resets, keeps the checkpoint so
# "continue" resumes after the reset. Days roll over at local midnight.
# AGENT_COST_CAP_FREE_DAILY=2
# AGENT_COST_CAP_FREE_MONTHLY=30
# AGENT_COST_CAP_PAID_DAILY=20
# AGENT_COST_CAP_PAID_MONTHLY=300
# AGENT_PAID_USERS=            # comma-separated user ids on the paid plan
# AGENT_COST_TZ=Asia/Shanghai

# LLM gateway retries (backoff) + empty escalate
LLM_MAX_RETRIES=2
# LLM_EMPTY_ESCALATE=1

# ===== Proactive execution (scheduler wake; default OFF) =====
# Set PROACTIVE_ENABLED=1 to start in-process tick loop with FastAPI.
# Soft budgets prevent runaway fan-out. Never auto-sends drafts.
PROACTIVE_ENABLED=0
# Default zone for schedules and reminders (profiles can override with their own tz)
PROACTIVE_TZ=Asia/Shanghai
# Tick period (seconds). Smoke can use 2–5.
# PROACTIVE_TICK_SECONDS=60
# PROACTIVE_MAX_USERS_PER_TICK=50
# PROACTIVE_SOFT_BUDGET_SECONDS=30


# ===== Companion (Q avatar / weekly report / food photo) =====
# 30 days without a visit -> the buddy sleeps; a new generation can be woken.
COMPANION_DORMANCY_DAYS=30
# Weekly report push (reuses Feishu/OpenClaw channel bindings; in-app inbox always).
COMPANION_WEEKLY_ENABLED=1
COMPANION_WEEKLY_WEEKDAY=6       # Monday=0 ... Sunday=6 (user timezone)
COMPANION_WEEKLY_HOUR=20
# Food photo (OpenAI-compatible multimodal). Empty = text-only logging, no guessing.
VISION_MODEL=
VISION_BASE_URL=                 # defaults to LLM_FAST_BASE_URL
VISION_API_KEY=                  # defaults to LLM_FAST_API_KEY

# ===== HTTP hardening (turn on for any internet-facing deployment) =====
# In-process token bucket; per worker/instance. 0 = off (good for local dev/tests).
API_RATE_LIMIT_ENABLED=1
API_RATE_LIMIT_PER_MINUTE=300
API_RATE_LIMIT_USER_PER_MINUTE=120
API_RATE_LIMIT_WINDOW_SECONDS=60
# Only set when a trusted proxy overwrites this header (e.g. x-envoy-external-address).
API_TRUSTED_PROXY_HEADER=
# Empty = same-origin only (the UI is served by this app). "*" or a comma-separated list.
CORS_ALLOW_ORIGINS=
# Set 0 on a public deployment if you do not want /docs and /openapi.json exposed.
ENABLE_DOCS=1

# ===== Secret sandbox (account logins / phone / ID card) =====
# Fernet key for encrypting values saved through the 安全输入区. Required: without it
# POST /api/secrets returns 503 and nothing is stored. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: comma-separate keys; the first encrypts, all of them decrypt.
# Losing the key makes saved values unreadable (users re-enter them).
SECRETS_FERNET_KEY=
# Local debugging only: allow the shared "demo" user to save secrets (default: refused).
# SECRETS_ALLOW_DEMO=0

# ===== Unified gateway (docs/llm-gateway.md) =====
# Optional multi-model registry (JSON/TOML) or inline JSON; see docs/llm_models.example.json
# LLM_CONFIG_FILE=docs/llm_models.example.json
# LLM_CONFIG_JSON=
# LLM_FAST_CHAIN=kimi-k2.6,deepseek-chat
# LLM_STRONG_CHAIN=kimi-k3,kimi-k2.6
# ANTHROPIC_API_KEY=
# Per-upstream-account concurrency: set to your Moonshot account's concurrency quota
# LLM_MAX_CONCURRENCY=8
# LLM_RPM=0
# LLM_QUEUE_TIMEOUT=10
# LLM_MAX_RETRIES=2
# LLM_MAX_RETRIES_RATE_LIMITED=4
# LLM_RETRY_ON_TIMEOUT=0
# LLM_DEADLINE_FACTOR=2.0
# Cost estimation for legacy env setup (price per 1M tokens)
# LLM_FAST_PRICE_INPUT=
# LLM_FAST_PRICE_OUTPUT=
# LLM_STRONG_PRICE_INPUT=
# LLM_STRONG_PRICE_OUTPUT=
# LLM_USAGE_LOG=/app/data/llm_usage.jsonl

# ===== Harness =====
# Admin token for GET /api/admin/traces (>=16 chars). Unset => trace query API disabled (503).
# HARNESS_ADMIN_TOKEN=
# Values that must never appear in any output (separate with |). Per-user: profile.privacy_sandbox.
# PRIVACY_SANDBOX_VALUES=
# Trace rows are written by a background batch writer (async). "sync" writes inline (debug only).
# TRACE_WRITE_MODE=async
# TRACE_QUEUE_MAX=10000
# Per-admin tokens (preferred over HARNESS_ADMIN_TOKEN): name:token[:scope|scope], comma separated.
# Scopes: traces:read, audit:read, feedback:write (omit => all). DB tokens: python scripts/admin_tokens.py create <name>
# HARNESS_ADMIN_TOKENS=alice:change-me-at-least-16-chars,bob:another-token-16-chars:traces:read
# HMAC key for user/thread pseudonyms in traces + identity index (>=16 chars).
# Unset => random key generated once at DATA_DIR/.harness_id_key (keep DATA_DIR persistent).
# HARNESS_ID_HMAC_KEY=
# PII detector: regex (default) | presidio | gliner | auto. Non-regex needs: pip install -r requirements-pii.txt
# PII_BACKEND=regex
# PII_MIN_SCORE=0.6
# PII_SPACY_MODEL=zh_core_web_sm
# GLINER_MODEL=urchade/gliner_multi_pii-v1
# Paraphrase / translation prompt-leak check. Char n-gram similarity is always on;
# embeddings are optional (requirements-pii.txt).
# PROMPT_LEAK_EMBEDDINGS=sentence-transformers
# PROMPT_LEAK_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# PROMPT_LEAK_EMB_THRESHOLD=0.8

# ===== Observability (Langfuse, self-hosted; see docs/langfuse.md) =====
# Off unless LANGFUSE_ENABLED=1 and both keys are set. Export is async (batched OTLP);
# all span data is redacted locally before it leaves the process.
# LANGFUSE_ENABLED=0
# LANGFUSE_HOST=https://langfuse.example.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_ENVIRONMENT=test
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0
# redacted (default) | none  — whether redacted prompt/response text is exported at all
# LANGFUSE_EXPORT_IO=redacted
# LANGFUSE_TIMEOUT_S=5
# Dataset that "add feedback to dataset" writes to
# LANGFUSE_FEEDBACK_DATASET=user-feedback
# Price table per 1M tokens for cost tracking: exact model, prefix*, or "*" default
# LLM_PRICES_JSON={"kimi-k2*": {"input": 4, "output": 16}}
# LLM_PRICE_CURRENCY=CNY
# LLM-as-judge: auto (LLM when configured, else heuristic) | llm | heuristic
# JUDGE_MODE=auto
# JUDGE_TIMEOUT_S=60

# Intent scoring: rules by default; hybrid sends unmatched text to SiliconFlow.
INTENT_SCORING_MODE=rules
# Supply SILICONFLOW_API_KEY only through your runtime environment.
